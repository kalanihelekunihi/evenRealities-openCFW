# openCFW .gitignore
#
# Rule of thumb: if `make` (or a tool under g2/tools/) can regenerate it, it does
# not belong in the repo. Source, manifests, provenance records, documentation
# and the vendored third-party snapshots ARE tracked -- they are build inputs.

# ---------------------------------------------------------------------------
# Build + analysis output
# ---------------------------------------------------------------------------
# G2: top-level build tree written by g2/tools/open_cfw.py (reference/,
# ring-source/, source/) plus every ad-hoc analysis-*, repro-*, agent-*,
# validation/, toolchains/ and tmp* scratch directory.
# R1: host binaries, freestanding object tree, and the SDK image tree.
# `make clean` deletes these wholesale.
build/
_build/

# Toolchain/host/probe build variants: build-linux, build-console-apple-a,
# build-task3-linux-probe, ...
build-*/

# Loose object/binary output, wherever it lands.
*.o
*.obj
*.a
*.elf
*.axf
*.out
*.hex
*.su
*.d
*.map
*.lst
*.so
*.dylib
*.dll
*.dSYM/

# Scratch/intermediate files from analysis runs.
tmp*/
*.tmp
*.bak
*.orig
*.rej
*.log

# G2-local canonical-observation/toolchain scratch and hydration state.  These
# paths can contain authenticated donor firmware and must never enter a future
# source export or commit.
/g2/.tmp-*
/g2/**/.tmp-*
/g2/.open-cfw-local-hydration.json
/g2/**/.open-cfw-canonical*.lock

# Recorded (non-canonical) manifest and overlay variants, replayed for
# compiler-profile experiments. The verifiers classify these as generated
# output; the canonical manifests/overlays alongside them are tracked.
/g2/manifests/*-record*.json
/g2/components/**/*-record*.json

# ---------------------------------------------------------------------------
# Python (g2/tools/, g2/tests/, third-party/fetched/)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
.tox/
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Research evidence is data, not build output
# ---------------------------------------------------------------------------
# g2/research/ holds delivered reverse-engineering evidence: Ghidra run logs,
# compiler-matrix object files, disassembly, and linked images. They share
# extensions with build output but are inputs -- authenticated by the delivered
# SHA256SUMS manifests and by g2/research/MANIFEST.sha256. Keep them.
!/g2/research/**
!/r1/research/**

# ---------------------------------------------------------------------------
# Vendor-proprietary inputs (not redistributable -- fetch locally)
# ---------------------------------------------------------------------------
# Official OTA payloads under g2/blobs/official/ are vendor-proprietary; the
# PROVENANCE.md alongside them records hashes and origin so a local copy can be
# reproduced and verified. Track the provenance, not the bytes.
/g2/blobs/official/**
!/g2/blobs/official/**/
!/g2/blobs/official/**/PROVENANCE.md

# The R1 reconstruction embeds the stock application, bootloader, UICR and
# APPROTECT images verbatim as C byte arrays. Those are the vendor firmware in
# another encoding, so the same policy applies: keep the reconstruction sources,
# manifest and verifier; supply the payload arrays locally.
# See r1/research/decompilation/rebuild/PROVENANCE.md.
/r1/research/decompilation/rebuild/*.bytes.inc
/r1/research/decompilation/rebuild/emit_image
/r1/research/decompilation/rebuild/rebuilt-*.bin
/firmware_blobs
/sdks

# ---------------------------------------------------------------------------
# Local R1 firmware signing secrets
# ---------------------------------------------------------------------------
# The OpenR1 DFU packager uses this encrypted P-256 owner key.  The matching
# public key, raw bootloader representation, manifest, and custody notes are
# reviewable build inputs; the private key must remain local.
/r1/config/r1-owner-signing/r1-owner-private.key

# Fetched vendor cache, if it is ever placed inside the tree.
/vendor-cache/

# Decompiler projects / databases -- large, regenerable from the blobs.
*.gpr
*.rep
*.gzf
*.i64
*.idb
*.bndb
/ghidra_projects/

# ---------------------------------------------------------------------------
# Editor / OS noise
# ---------------------------------------------------------------------------
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
!.vscode/extensions.json
compile_commands.json
.cache/
/.claude
