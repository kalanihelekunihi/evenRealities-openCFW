          "u32[0xa2000000]=3079",
          "u32[0xa2000004]=0xffffffff",
          "u32[0xa2000010]=1",
          "u32[0xa2000018]=0",
          "u32[0xA20000F4]=0",
          "u32[0xa2000008]=1",
          "u32[0xa2000060]=0x00000035",
          "poll u32[0xA2000020] until zero",
          "call B4C()",
          "return R0=0"
        ],
        "bytes_stored": [],
