    {
      "name": "three bytes across 32-bit pointer wrap",
      "inputs": {
        "R0": 3,
        "R1": "0xFFFFFFFE",
        "R2": 3,
        "data_words": [
          170,
          187,
          204
        ],
        "ready_bit2": true,
        "completion_word": 0
      },
      "expected": {
        "events": [
          "call B4C()",
          "u32[0xa2000008]=0",
          "u32[0xa200004c]=0",
          "u32[0xa2000000]=3079",
          "u32[0xa2000004]=0x00000002",
          "u32[0xa2000010]=1",
          "u32[0xa2000018]=0",
          "u32[0xA20000F4]=0",
          "u32[0xa2000008]=1",
          "u32[0xa2000060]=0x00000003",
          "poll u32[0xA2000028]&2 until nonzero",
          "u32[0xA2000060] -> 0x000000aa",
          "u8[0xfffffffe]=0xaa",
          "poll u32[0xA2000028]&2 until nonzero",
          "u32[0xA2000060] -> 0x000000bb",
          "u8[0xffffffff]=0xbb",
          "poll u32[0xA2000028]&2 until nonzero",
          "u32[0xA2000060] -> 0x000000cc",
          "u8[0x00000000]=0xcc",
          "poll u32[0xA2000020] until zero",
          "call B4C()",
          "return R0=0"
        ],
        "bytes_stored": [
          "u8[0xfffffffe]=0xaa",
          "u8[0xffffffff]=0xbb",
          "u8[0x00000000]=0xcc"
        ],
