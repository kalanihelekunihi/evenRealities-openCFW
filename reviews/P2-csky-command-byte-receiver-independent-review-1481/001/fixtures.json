{
  "schema": "csky-command-byte-receiver-fixtures-v1",
  "method": "Manual trace against exact original bytes; returned data words and B4C/MMIO status are controlled fixture values, not hardware execution.",
  "body_sha256": "3709c9c3439611f8c906ee506ceebc69d1003a92765424e5f4e294503ab289ea",
  "cases": [
    {
      "name": "mode 3 receives exactly three bytes",
      "inputs": {
        "R0": 3,
        "R1": "0x20000004",
        "R2": 3,
        "data_words": [
          18,
          52,
          86
        ],
        "ready_bit2": true,
        "completion_word": 0
      },
      "expected": {
        "events": [
          "call B4C()",
          "u32[0xa2000008]=0",
          "u32[0xa200004c]=0",
          "u32[0xa2000000]=3079",
          "u32[0xa2000004]=0x00000002",
          "u32[0xa2000010]=1",
          "u32[0xa2000018]=0",
          "u32[0xA20000F4]=0",
          "u32[0xa2000008]=1",
          "u32[0xa2000060]=0x00000003",
          "poll u32[0xA2000028]&2 until nonzero",
          "u32[0xA2000060] -> 0x00000012",
          "u8[0x20000004]=0x12",
          "poll u32[0xA2000028]&2 until nonzero",
          "u32[0xA2000060] -> 0x00000034",
          "u8[0x20000005]=0x34",
          "poll u32[0xA2000028]&2 until nonzero",
          "u32[0xA2000060] -> 0x00000056",
          "u8[0x20000006]=0x56",
          "poll u32[0xA2000020] until zero",
          "call B4C()",
          "return R0=0"
        ],
        "bytes_stored": [
          "u8[0x20000004]=0x12",
          "u8[0x20000005]=0x34",
          "u8[0x20000006]=0x56"
        ],
        "final_R1": "0x20000007",
        "return": "0x00000000"
      }
    },
    {
