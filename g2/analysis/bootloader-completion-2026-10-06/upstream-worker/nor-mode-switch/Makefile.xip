CC = clang
LD = arm-none-eabi-ld
PYTHON ?= /Users/kalani/.local/share/opencfw/venv/bin/python
ROOT := ../../../../../
COMP := $(ROOT)/g2/components/bootloader/nor_mspi_power
OUT ?= out
CFLAGS := --target=arm-none-eabi -mcpu=cortex-m4 -mthumb -mfloat-abi=soft \
	-ffreestanding -fno-builtin -ffunction-sections -fdata-sections \
	-std=c11 -O2 -Wall -Wextra -Werror

.PHONY: all verify
all: $(OUT)/xip-address-mode.elf

$(OUT):
	mkdir -p $@

$(OUT)/xip_address_mode.o: $(COMP)/xip_address_mode.c $(COMP)/xip_address_mode.h | $(OUT)
	$(CC) $(CFLAGS) -I$(COMP) -c $< -o $@

$(OUT)/xip-address-mode.elf: $(OUT)/xip_address_mode.o xip_address_mode.ld
	$(LD) --gc-sections -T xip_address_mode.ld -o $@ $(OUT)/xip_address_mode.o

verify: $(OUT)/xip-address-mode.elf
	$(PYTHON) verify_xip_address_mode.py --elf $(OUT)/xip-address-mode.elf --output $(OUT)/xip-address-mode-differential.json
