      "operations": [
        "snapshot numToCopy from Cy_SCB_GetNumInRxFifo(base)",
        "clamp numToCopy to requested size",
        "call Cy_SCB_ReadArrayNoCheck exactly once",
        "return numToCopy"
      ],
      "count_unit": "FIFO data elements",
      "zero_count_call": true,
      "blocking": false
