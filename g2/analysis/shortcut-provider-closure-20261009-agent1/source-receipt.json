  "source_correlations": {
    "strlen": "byte scan to NUL then pointer subtraction; generic equivalence, not unique source identity",
    "strncmp": "unsigned-byte subtraction, n==0 returns zero, stops at mismatch or NUL; generic equivalence",
    "printf_": "three-argument call (0,fmt,varargs) agrees with tinyprintf vfprintf wrapper and rejects direct five-argument _vsnprintf wrapper; callee semantics remain open",
    "memset": "stock first aligns an unaligned destination and then word-fills; public C keeps originally unaligned destinations on byte-only path, so not direct producing-source identity",
    "clk_switch_1m": "source table [28,0,18,1], two gx_clock_set_source calls, gate scan module11..25, PLL disable/restore agree with board source family; board and configuration identity unresolved"
  }
