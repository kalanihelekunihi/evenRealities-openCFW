+        IOMn(ui32Module)->DMATRIGEN = _VAL2FLD(IOM0_DMATRIGEN_DTHREN, 1);
+        IOMn(ui32Module)->DMATOTCOUNT = psTransaction->ui32NumBytes;
+        IOMn(ui32Module)->DMATARGADDR = (uint32_t)psTransaction->pui32RxBuffer;
+        IOMn(ui32Module)->DMACFG =
