+    IOMn(ui32Module)->DMACFG_b.DMAEN = 0;
+    IOMn(ui32Module)->DMATRIGEN = pIOMState->sFdNb.ui32SavedDmaTrigEn;
+    IOMn(ui32Module)->MSPICFG_b.FULLDUP = 0;
