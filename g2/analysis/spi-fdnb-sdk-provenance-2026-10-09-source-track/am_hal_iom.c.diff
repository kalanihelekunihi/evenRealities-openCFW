+static void
+iom_fdnb_drain_rx_fifo(am_hal_iom_state_t *pIOMState)
+{
+    uint32_t ui32Module = pIOMState->ui32Module;
+    uint32_t i;
+    while (pIOMState->sFdNb.ui32RxBytesLeft && (IOMn(ui32Module)->FIFOPTR_b.FIFO1SIZ >= 4))
+    {
+        uint32_t ui32Word = IOMn(ui32Module)->FIFOPOP;
+        uint32_t ui32Chunk = (pIOMState->sFdNb.ui32RxBytesLeft >= 4) ? 4 : pIOMState->sFdNb.ui32RxBytesLeft;
+        for (i = 0; i < ui32Chunk; i++)
+        {
+            *pIOMState->sFdNb.pui8RxBuf++ = (uint8_t)(ui32Word & 0xFF);
+            ui32Word >>= 8;
+        }
+        pIOMState->sFdNb.ui32RxBytesLeft -= ui32Chunk;
+    }
+}
+
+static void
+iom_fdnb_fill_tx_fifo(am_hal_iom_state_t *pIOMState)
+{
+    uint32_t ui32Module = pIOMState->ui32Module;
+
+    while (pIOMState->sFdNb.ui32TxBytesLeft && (IOMn(ui32Module)->FIFOPTR_b.FIFO0REM >= 4))
+    {
+        uint32_t i;
+        uint32_t ui32Chunk = (pIOMState->sFdNb.ui32TxBytesLeft >= 4) ? 4 : pIOMState->sFdNb.ui32TxBytesLeft;
+        uint32_t ui32Word = 0;
+
+        for (i = 0; i < ui32Chunk; ++i)
+        {
+            ui32Word |= ((uint32_t)(*pIOMState->sFdNb.pui8TxBuf++)) << (8 * i);
+        }
+
+        IOMn(ui32Module)->FIFOPUSH = ui32Word;
+        pIOMState->sFdNb.ui32TxBytesLeft -= ui32Chunk;
+    }
+}
